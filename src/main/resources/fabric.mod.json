{
  "schemaVersion": 1,
  "id": "runitback",
  "version": "${version}",
  "name": "Run It Back",
  "description": "Hardcore run tracker for friend groups: attempts, deaths, splits, boss kills and one-command world resets. Server-side only; players join with vanilla clients.",
  "authors": ["XeTrinity"],
  "contact": {
    "sources": "https://github.com/XeTrinity/run-it-back",
    "issues": "https://github.com/XeTrinity/run-it-back/issues"
  },
  "license": "MIT",
  "environment": "server",
  "entrypoints": {
    "main": ["dev.runitback.server.RunItBackMod"],
    "preLaunch": ["dev.runitback.reset.ResetBoot"]
  },
  "mixins": ["runitback.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_range}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
